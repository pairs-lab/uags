+               n_strong=int(strong.sum()), pair_cos_median=float(med), feat_dim=d, seed=a.seed,
+               auroc={k: auroc(v, y) for k, v in scores.items()},
+               n_undefined={k: int((~torch.isfinite(torch.as_tensor(v))).sum()) for k, v in scores.items()},
