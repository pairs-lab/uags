+        for q in qs:
+            thr = float(torch.quantile(null, q))
+            fired = alt > thr
+            out[str(q)] = dict(thr=thr, fired_changed=float(fired[torch.tensor(changed)].float().mean()),
+                               fired_static=float(fired[torch.tensor(~changed)].float().mean()))
